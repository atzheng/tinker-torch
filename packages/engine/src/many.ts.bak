// trainMany: k copies of one compiled model trained in one jitted, vmapped step (CONTRACTS.md
// section 7). Copy i is exactly `init(seeds[i])` + `startTraining(.., seeds[i])` + `steps` calls of
// `engine.step` on data[i], the whole thing vectorised.
//
// Ownership: everything allocated here is disposed before returning, also when a step throws. The
// data and the stacked state are passed to the jitted function as arguments (never captured: an
// array constant captured in a trace is never freed). The jitted function consumes its arguments.
import { jit, numpy as np, random, tree, vmap } from '@jax-js/jax';
import type { Array as JArray } from '@jax-js/jax';
import type * as optax from '@jax-js/optax';
import { analyse, fitTrees, initParams, resolveEdge, treeLeafCounts } from '@tinker/core';
import type { Analysis, Batch, Graph, HostParams, NodeId, TreeFits } from '@tinker/core';
import { compile, compilePadded, disposeCompiled, internals, xHost } from './compile.js';
import type { Internals } from './compile.js';
import type { ParamTree } from './convert.js';
import type { ManyResult, Model } from './types.js';

type ManyStepFn = (
  params: ParamTree,
  opt: optax.OptState,
  x: JArray,
  y: JArray,
  key: JArray,
) => [ParamTree, optax.OptState, JArray, JArray];

/** The state a copy carries between steps: stacked params, optimizer state and dropout key. */
type Carry = [ParamTree, optax.OptState, JArray];

/** One jitted vmapped step per compiled model (it holds no array constants, only code). */
const manySteps = new WeakMap<Internals, ManyStepFn>();

/**
 * The vmapped step. Inputs are stacked on a leading axis k. Returns [params, opt, ok, key] with
 * ok [k] = 1 for a copy whose loss and updated parameters are all finite this step and whose
 * unfused probability preds stay inside (0, 1). Consumes all its arguments.
 */
function manyStep(m: Internals): ManyStepFn {
  const cached = manySteps.get(m);
  if (cached) return cached;
  // With unfused probability losses the step also returns each pred's min and max, [k, 2P] after vmap.
  const withRange = m.probLosses.length > 0;
  const vstep = vmap(withRange ? m.stepRangeFn() : m.stepFn());
  const fn = jit((params: ParamTree, opt: optax.OptState, x: JArray, y: JArray, key: JArray) => {
    const [newP, newO, loss, check, newK, range] = vstep(params, opt, x, y, key) as [
      ParamTree,
      optax.OptState,
      JArray,
      JArray,
      JArray,
      JArray | undefined,
    ];
    // jax-js folds x * 0 to 0 (NaN included), so finiteness is tested with isfinite: the loss and
    // every updated parameter of the copy
    check.dispose();
    const k = loss.shape[0] ?? 1;
    let finite = np.isfinite(loss).astype(np.float32);
    let count = 0;
    for (const leaf of tree.leaves(tree.ref(newP)) as JArray[]) {
      const per = leaf.shape.slice(1).reduce((p, q) => p * q, 1);
      count += per;
      finite = finite.add(np.isfinite(leaf).astype(np.float32).reshape([k, per]).sum(1));
    }
    let ok = finite.equal(count + 1).astype(np.float32);
    if (range) {
      // a pred leaving (0, 1) freezes the copy like a divergence (as `step` does); NaN fails too
      for (let i = 0; i < m.probLosses.length; i++) {
        const lo = range.ref.slice([], [2 * i, 2 * i + 1]).reshape([k]);
        const hi = range.ref.slice([], [2 * i + 1, 2 * i + 2]).reshape([k]);
        ok = ok.mul(lo.greater(0).astype(np.float32)).mul(hi.less(1).astype(np.float32));
      }
      range.dispose();
    }
    return [newP, newO, ok, newK];
  }) as unknown as ManyStepFn;
  manySteps.set(m, fn);
  m.disposables.add(fn as unknown as { dispose(): void });
  return fn;
}

/**
 * Per copy, keeps `fresh` where `alive` is 1 and `old` where it is 0 (a diverged copy stays at its
 * last finite state). Only used once some copy has diverged. Consumes all three arguments.
 */
let freezeFn: ((alive: JArray, fresh: Carry, old: Carry) => Carry) | null = null;
function freeze(alive: JArray, fresh: Carry, old: Carry): Carry {
  freezeFn ??= jit((a: JArray, f: Carry, o: Carry) => {
    const sel = (x: JArray, y: JArray): JArray => {
      const cond = a.ref.reshape([a.shape[0] ?? 1, ...x.shape.slice(1).map(() => 1)]);
      return np.where(cond.greater(0), x, y);
    };
    const out = tree.map(sel, f, o) as Carry;
    a.dispose();
    return out;
  }) as unknown as (alive: JArray, fresh: Carry, old: Carry) => Carry;
  return freezeFn(alive, fresh, old);
}

const size = (a: JArray): number => a.shape.reduce((p, q) => p * q, 1);

/** Stacks one host array per copy into a [k, ...shape] jax array. */
function stacked(parts: Float32Array[], shape: number[]): JArray {
  const each = parts[0]?.length ?? 0;
  const flat = new Float32Array(parts.length * each);
  parts.forEach((p, i) => flat.set(p, i * each));
  return np.array(flat, { shape: [parts.length, ...shape], dtype: np.float32 });
}

const prod = (shape: readonly number[]): number => shape.reduce((p, q) => p * q, 1);

/**
 * Copies the block both shapes share (same rank, row-major) into a new array of shape `to`, zero
 * where `from` has no entry. Pads when `to` is larger, strips when it is smaller.
 */
function reblock(src: Float32Array, from: readonly number[], to: readonly number[]): Float32Array {
  if (from.length === to.length && from.every((v, i) => v === to[i])) return src;
  const out = new Float32Array(prod(to));
  const nd = from.length;
  const common = from.map((v, i) => Math.min(v, to[i] ?? 0));
  const idx = new Array<number>(nd).fill(0);
  const total = prod(common);
  for (let c = 0; c < total; c++) {
    let a = 0;
    let b = 0;
    for (let i = 0; i < nd; i++) {
      a = a * (from[i] ?? 1) + (idx[i] ?? 0);
      b = b * (to[i] ?? 1) + (idx[i] ?? 0);
    }
    out[b] = src[a] ?? 0;
    for (let i = nd - 1; i >= 0; i--) {
      idx[i] = (idx[i] ?? 0) + 1;
      if ((idx[i] ?? 0) < (common[i] ?? 1)) break;
      idx[i] = 0;
    }
  }
  return out;
}

type Shapes = Record<NodeId, Record<string, number[]>>;

/** `host` (laid out as `from`) re-laid out as `to`, for every node and tensor of `to`. */
function reshapeHost(host: HostParams, from: Shapes, to: Shapes): HostParams {
  const out = Object.create(null) as HostParams;
  for (const [id, shapes] of Object.entries(to)) {
    const h = Object.create(null) as HostParams[string];
    for (const [name, shape] of Object.entries(shapes)) {
      const src = host[id]?.[name];
      const was = from[id]?.[name];
      if (!src || !was) continue;
      h[name] = reblock(src, was, shape);
    }
    out[id] = h;
  }
  return out;
}

/** Throws a plain sentence when the arguments do not fit (before anything is allocated). */
function checkMany(m: Internals, seeds: number[], data: Batch[], steps: number): void {
  const k = seeds.length;
  if (k < 1) throw new Error('trainMany needs at least one copy.');
  if (data.length !== k) throw new Error('Each copy needs its own training set.');
  if (!Number.isInteger(steps) || steps < 0)
    throw new Error('The number of steps must be 0 or more.');
  const d = m.dataColumns.length;
  const n = data[0]?.n ?? 0;
  if (!Number.isInteger(n) || n < 1) throw new Error('Each training set needs at least one row.');
  for (const b of data) {
    if (b.n !== n) throw new Error('All copies need training sets of the same size.');
    if (b.x.length !== n * d)
      throw new Error(`A training set x has ${b.x.length} values, expected ${n} x ${d}.`);
    if (b.y.length !== n)
      throw new Error(`A training set y has ${b.y.length} values, expected ${n}.`);
  }
}

/**
 * Borrows everything. Trains k = `seeds.length` copies for `steps` full-batch steps and returns the
 * trained parameters per copy (index i = seeds[i], data[i]). Every `data[i]` must have the same `n`.
 * The loss is read back every step (jax-js is lazy). A copy that diverges stops at its last finite
 * parameters and is flagged `diverged: true`; the others are unaffected. Stops early when every
 * copy has diverged. Throws a plain sentence on a bad argument.
 */
export function trainMany(
  model: Model,
  seeds: number[],
  data: Batch[],
  steps: number,
): ManyResult[] {
  const user = internals(model);
  checkMany(user, seeds, data, steps);
  if (user.trees.length === 0) {
    return trainCopies(
      user,
      seeds,
      data,
      steps,
      data.map(() => ({})),
      null,
    );
  }
  // Trees: each copy fits its own trees on its own training rows. When every Tree output goes
  // straight into a Linear (`paddingIsNeutral`) the copies are trained as one vmapped step on a
  // sibling model whose one-hots are padded to the largest leaf count of each tree (zero columns);
  // the Linear weights of the padded columns start at 0, get zero gradient and never change a
  // prediction. The padding is stripped from the returned params. Otherwise (a link, Add, ... reads
  // a Tree) zeros are not neutral, so copies with different leaf counts are trained one at a time
  // on a model compiled from their own fits.
  const info = user.data;
  const fits = data.map((b) =>
    fitTrees(user.graph, { info, nTrain: b.n, xTrain: b.x, yTrain: b.y }),
  );
  const most: Record<NodeId, number> = {};
  for (const t of user.trees) {
    for (const f of fits) {
      const fit = Object.hasOwn(f, t.id) ? f[t.id] : undefined;
      if (!fit) throw new Error('A Tree could not be fitted to a training set.');
      most[t.id] = Math.max(most[t.id] ?? 1, fit.leaves);
    }
  }
  const same = user.trees.every((t) => fits.every((f) => f[t.id]?.leaves === fits[0]?.[t.id]?.leaves));
  if (!same && !paddingIsNeutral(user.graph)) {
    const out: ManyResult[] = [];
    data.forEach((b, c) => {
      let own: Model;
      try {
        own = compile(user.graph, info, fits[c] ?? {});
      } catch (e) {
        const why = e instanceof Error ? e.message : 'the graph does not fit';
        throw new Error(`Copy ${c + 1} cannot be trained with its own trees: ${why}`);
      }
      try {
        const [r] = trainCopies(internals(own), [seeds[c] ?? 0], [b], steps, [fits[c] ?? {}], null);
        if (r) out.push(r);
      } finally {
        disposeCompiled(own);
      }
    });
    return out;
  }
  const padded = compilePadded(user, most);
  try {
    // init with each copy's real leaf counts (fan-in = its real leaf count), then pad
    const analyses = fits.map((f) => analyse(user.graph, info, treeLeafCounts(f)));
    const own: Shapes[] = analyses.map((a) => a.paramShapes);
    return trainCopies(internals(padded), seeds, data, steps, fits, { analyses, own });
  } finally {
    disposeCompiled(padded);
  }
}

/**
 * True when zero-padding a Tree's one-hot cannot change a copy: every wire out of every Tree goes
 * into the `in` port of a Linear and no prediction or the loss is a Tree itself.
 */
export function paddingIsNeutral(graph: Graph): boolean {
  const trees = new Set(graph.nodes.filter((n) => n.type === 'tree').map((n) => n.id));
  const type = new Map(graph.nodes.map((n) => [n.id, n.type]));
  for (const e of graph.edges) {
    const r = resolveEdge(graph.nodes, e);
    if (!r.ok || !trees.has(r.from.node)) continue;
    if (type.get(r.to.node) !== 'linear' || r.to.port !== 'in') return false;
  }
  return ![...graph.predictions, graph.loss].some((p) => trees.has(p.split('.')[0] ?? ''));
}

/** What trainCopies needs of a tree model: each copy's own analysis (init and unpadded shapes). */
type Per = { analyses: Analysis[]; own: Shapes[] };

/**
 * Trains the copies on `m` (the padded sibling for Tree models, `per` set). `fits[i]` are copy i's
 * tree fits. Borrows everything; see `trainMany`.
 */
function trainCopies(
  m: Internals,
  seeds: number[],
  data: Batch[],
  steps: number,
  fits: TreeFits[],
  per: Per | null,
): ManyResult[] {
  const k = seeds.length;
  const n = data[0]?.n ?? 0;
  const d = m.dataColumns.length + m.treeWidth;
  const paddedShapes: Shapes = Object.fromEntries(m.shapes);
  const inits = seeds.map((s, i) => {
    const a = per?.analyses[i];
    return a
      ? reshapeHost(initParams(a, s), per?.own[i] ?? {}, paddedShapes)
      : initParams(m.analysis, s);
  });
  let params: ParamTree = {};
  for (const [id, s] of m.shapes) {
    const layer: ParamTree[string] = {};
    for (const [k, shape] of Object.entries(s)) {
      layer[k] = stacked(
        inits.map((h) => h[id]?.[k] ?? new Float32Array(0)),
        shape,
      );
    }
    params[id] = layer;
  }
  let opt = tree.map(
    // the step counter is a scalar: give every copy its own
    (a: JArray) => (a.ndim === 0 ? np.broadcastTo(a, [k]) : a),
    m.optimizer().init(tree.ref(params)),
  ) as optax.OptState;
  let key = np.stack(seeds.map((s) => random.key(s)));
  const x = stacked(
    data.map((b, i) => xHost(m, b.x, n, fits[i])),
    [n, d],
  );
  const y = stacked(
    data.map((b) => b.y),
    [n],
  );
  const diverged = new Array<boolean>(k).fill(false);

  const step = manyStep(m);
  let prev: Carry | null = null;
  try {
    for (let i = 0; i < steps; i++) {
      // the call consumes params, opt and key: keep references to the state before the step, which
      // a copy that diverges in this step returns to
      prev = [tree.ref(params), tree.ref(opt), key.ref];
      const out = step(params, opt, x.ref, y.ref, key);
      const ok = out[2].dataSync() as Float32Array; // reading every step forces evaluation
      const wasClean = !diverged.includes(true);
      for (let c = 0; c < k; c++) if (ok[c] === 0) diverged[c] = true;
      if (wasClean && !diverged.includes(true)) {
        tree.dispose(prev[0]);
        tree.dispose(prev[1]);
        prev[2].dispose();
        [params, opt, , key] = out;
      } else {
        const alive = np.array(Float32Array.from(diverged, (d) => (d ? 0 : 1)));
        [params, opt, key] = freeze(alive, [out[0], out[1], out[3]], prev);
      }
      prev = null;
      if (!diverged.includes(false)) break;
    }
    const result: ManyResult[] = [];
    const host = (a: JArray, c: number, size: number): Float32Array =>
      Float32Array.from((a.ref.dataSync() as Float32Array).subarray(c * size, (c + 1) * size));
    for (let c = 0; c < k; c++) {
      const hp = Object.create(null) as HostParams;
      for (const [id, l] of Object.entries(params)) {
        const h = Object.create(null) as HostParams[string];
        for (const [name, a] of Object.entries(l)) h[name] = host(a, c, size(a) / k);
        hp[id] = h;
      }
      const own = per?.own[c];
      result.push({
        params: own ? reshapeHost(hp, paddedShapes, own) : hp,
        diverged: diverged[c] ?? false,
        fits: fits[c] ?? {},
      });
    }
    return result;
  } finally {
    // after a throwing step some of these were already consumed by it
    for (const h of [params, opt, key, x, y, prev]) {
      try {
        if (h) tree.dispose(h as ParamTree);
      } catch {
        // already consumed
      }
    }
  }
}
