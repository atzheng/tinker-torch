{
  "kind": "tinker",
  "version": 2,
  "title": "Logistic regression on blobs",
  "graph": {
    "version": 2,
    "nodes": [
      {
        "id": "x",
        "type": "input",
        "columns": ["x1", "x2"]
      },
      {
        "id": "lin1",
        "type": "linear",
        "out": 1,
        "bias": true
      },
      {
