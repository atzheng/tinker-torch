{
  "kind": "tinker",
  "version": 2,
  "title": "Lecture 1, stage 4: a number that depends on the distance",
  "prompt": "Now the chance of being late depends on distance and on the zone of the city. Train the Weight, the Bias and one number for each zone.",
  "instructions": [
    "Press Run. The fit plot colours the area by the chance of late.",
    "Switch to Neurons to see one dial for each zone.",
    "Which zone is later than the others? Press Reset and Run again to check."
  ],
  "show": {
    "palette": ["inputs", "categories", "scalew", "sum", "bias", "sigmoid"],
    "tab": "model",
    "ui": [
      "preset-menu",
      "btn-undo",
      "btn-redo",
      "data-resample",
      "file-menu",
      "tab-model",
      "tab-loss",
      "grain-toggle",
      "fit-view",
      "tidy-layout",
      "reset-view",
      "instructions",
      "preset-prompt",
      "success-check",
      "panel-fit",
      "panel-loss",
      "panel-loss-1d",
      "panel-class-bars",
      "panel-surface",
      "loss-readout",
      "loss-mode-likelihood",
      "loss-mode-total",
      "loss-mode-mean",
      "loss-1d-tangent",
      "loss-log-toggle",
      "loss-val",
      "truth-toggle",
      "btn-step",
      "btn-reset",
      "lr-slider",
      "step-count",
      "btn-run",
      "btn-random-start",
      "param-count"
    ],
    "panelTabs": {
      "loss": ["model", "loss"]
    }
  },
  "labels": {
    "loss-readout": "Score",
    "lr-slider": "Step size",
    "btn-random-start": "Try another start"
  },
  "options": {
    "loss-mode": "mean"
  },
  "graph": {
    "version": 2,
    "nodes": [
      {
        "id": "x",
        "type": "input",
        "columns": ["x1"]
      },
      {
        "id": "w",
        "type": "scalew"
      },
      {
        "id": "sum",
        "type": "sum"
      },
      {
        "id": "bias",
        "type": "bias"
      },
      {
        "id": "yhat",
        "type": "link",
        "fn": "sigmoid"
      },
      {
        "id": "y",
        "type": "target"
      },
      {
        "id": "err",
        "type": "log_loss"
      },
      {
        "id": "loss",
        "type": "mean"
      },
      {
        "id": "z",
        "type": "input",
        "columns": ["x4"]
      },
      {
        "id": "zone",
        "type": "lookup",
        "width": 1
      }
    ],
    "edges": [
      ["x", "w"],
      ["w", "sum"],
      ["sum", "bias"],
      ["bias", "yhat"],
      ["yhat", "err.pred"],
      ["y", "err.target"],
      ["err", "loss"],
      ["z", "zone"],
      ["zone", "sum"]
    ],
    "predictions": ["yhat"],
    "loss": "loss",
    "data": {
      "set": "delivery_late",
      "n": 200,
      "noise": 0.3,
      "val": 0.2,
      "seed": 7,
      "standardize": true
    },
    "train": {
      "optimizer": "sgd",
      "lr": 0.1,
      "batch": "full",
      "seed": 11
    }
  },
  "params": {
    "w": 0,
    "bias": 0,
    "zone": {
      "W": [0, 0, 0, 0]
    }
  }
}
