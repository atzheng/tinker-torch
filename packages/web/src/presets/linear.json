{
  "kind": "tinker",
  "version": 1,
  "title": "Linear regression on a line",
  "graph": {
    "version": 1,
    "nodes": [
      {
        "id": "x",
        "type": "input",
        "columns": ["x1"]
      },
      {
        "id": "lin1",
        "type": "linear",
        "out": 1,
        "bias": true
      },
      {
        "id": "yhat",
        "type": "output",
        "link": "identity"
      },
      {
        "id": "y",
        "type": "target"
      },
      {
        "id": "loss",
        "type": "loss",
        "fn": "squared_error"
      }
    ],
    "edges": [
      ["x", "lin1"],
      ["lin1", "yhat"],
      ["yhat", "loss.pred"],
      ["y", "loss.target"]
    ],
    "data": {
      "set": "line",
      "n": 40,
      "noise": 0.2,
      "val": 0.3,
      "seed": 7
    },
    "train": {
      "optimizer": "sgd",
      "lr": 0.05,
      "batch": "full",
      "seed": 11
    }
  }
}
