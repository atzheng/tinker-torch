{
  "name": "@tinker/engine",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./probe": "./src/probe.ts"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -b",
    "build": "tsc -b",
    "spike": "node --experimental-strip-types --no-warnings spike/node.ts",
    "spike:web": "pnpm --filter @tinker/web exec vite ../engine/spike/web --config ../engine/spike/web/vite.config.ts"
  },
  "dependencies": {
    "@jax-js/jax": "0.1.27",
    "@jax-js/optax": "0.1.3",
    "@tinker/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "~6.0.3",
    "vitest": "^4.1.12"
  }
}
