      ["lin1", "yhat"],
      ["yhat", "err.pred"],
      ["y", "err.target"],
      ["err", "loss"]
    ],
    "predictions": ["yhat"],
    "loss": "loss",
    "data": {
      "set": "blobs",
      "n": 60,
      "noise": 0.3,
      "val": 0.3,
      "seed": 7,
      "standardize": false
    },
    "train": {
