{
  "kind": "tinker",
  "version": 2,
  "title": "Lecture 1, stage 0: one number, how likely is the data?",
  "prompt": "Each delivery is on time or late. Pick one number, the chance a delivery is late, so that these 30 deliveries look as likely as possible.",
  "instructions": [
    "Set the number to 0.5 and read the score. Then try 0.2, 0.4 and 0.7.",
    "Watch the curve: the dot is where you are. Which value of the number gives the highest likelihood?",
    "Switch the score to Total surprise and to Average surprise. Which direction is better for each?"
  ],
  "locked": ["bias", "y", "err", "loss"],
  "show": {
    "palette": [],
    "tab": "loss",
    "ui": [
      "preset-menu",
      "tab-loss",
      "instructions",
      "preset-prompt",
      "success-check",
      "panel-score",
      "panel-loss-1d",
      "panel-examples",
      "loss-readout",
      "loss-mode-likelihood",
      "loss-mode-total",
      "loss-mode-mean"
    ]
  },
  "labels": {
    "loss-readout": "Score",
    "panel-loss-1d": "Score for each possible number",
    "panel-examples": "The 30 deliveries"
  },
  "options": {
    "loss-mode": "likelihood"
  },
  "graph": {
    "version": 2,
    "nodes": [
      {
        "id": "bias",
        "type": "bias"
      },
      {
        "id": "y",
        "type": "target"
      },
      {
        "id": "err",
        "type": "log_loss"
      },
      {
        "id": "loss",
        "type": "mean"
      }
    ],
    "edges": [
      ["bias", "err.pred"],
      ["y", "err.target"],
      ["err", "loss"]
    ],
    "predictions": ["bias"],
    "loss": "loss",
    "data": {
      "set": "delivery_late",
      "n": 30,
      "noise": 0.3,
      "val": 0,
      "seed": 1,
      "standardize": false
    },
    "train": {
      "optimizer": "sgd",
      "lr": 0.15,
      "batch": "full",
      "seed": 11
    }
  },
  "params": {
    "bias": 0.5
  }
}
