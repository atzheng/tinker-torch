{
  "kind": "tinker",
  "version": 2,
  "title": "Trees for classification, stage 1: how flexible should the tree be?",
  "prompt": "A tree cuts the plane into rectangles and predicts one class for each. Make it deeper and watch the training loss and the shaded regions.",
  "instructions": [
    "Press Run. The shading shows what the model predicts at each place, and the line is where it switches class.",
    "Raise the depth, press Reset and Run again. How do the rectangles change?",
    "Where does the training loss stop improving? Does a deeper tree always draw a better boundary?"
  ],
  "locked": [
    "x",
    "tree",
    "lin1",
    "yhat",
    "y",
    "err",
    "loss"
  ],
  "show": {
    "palette": [],
    "tab": "model",
    "ui": [
      "preset-menu",
      "btn-undo",
      "btn-redo",
      "instructions",
      "preset-prompt",
      "tab-model",
      "tab-loss",
      "panel-fit",
      "panel-loss",
      "loss-readout",
      "tree-depth",
      "btn-run",
      "btn-reset",
      "step-count",
      "data-resample"
    ],
    "panelTabs": {
      "loss": [
        "model",
        "loss"
      ]
    }
  },
  "options": {
    "val-points-toggle": false
  },
  "labels": {
    "loss-readout": "Score",
    "data-resample": "New sample"
  },
  "graph": {
    "version": 2,
    "nodes": [
      {
        "id": "x",
        "type": "input",
        "columns": [
          "x1",
          "x2"
        ]
      },
      {
        "id": "tree",
        "type": "tree",
        "criterion": "gini",
        "depth": 1,
        "minSplit": 2,
        "minLeaf": 1,
        "minDecrease": 0
      },
      {
        "id": "lin1",
        "type": "linear",
        "out": 1,
        "bias": true
      },
      {
        "id": "yhat",
        "type": "link",
        "fn": "sigmoid"
      },
      {
        "id": "y",
        "type": "target"
      },
      {
        "id": "err",
        "type": "log_loss"
      },
      {
        "id": "loss",
        "type": "mean"
      }
    ],
    "edges": [
      [
        "x",
        "tree"
      ],
      [
        "tree",
        "lin1"
      ],
      [
        "lin1",
        "yhat"
      ],
      [
        "yhat",
        "err.pred"
      ],
      [
        "y",
        "err.target"
      ],
      [
        "err",
        "loss"
      ]
    ],
    "predictions": [
      "yhat"
    ],
    "loss": "loss",
    "data": {
      "set": "moons",
      "n": 120,
      "noise": 0.5,
      "val": 0.4,
      "seed": 5,
      "standardize": true
    },
    "train": {
      "optimizer": "adam",
      "lr": 0.1,
      "batch": "full",
      "seed": 11
    }
  }
}
